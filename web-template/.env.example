# Nothing here is required for a static demo build.

# Deploy mode. Unset (default) = static export to out/ for Cloudflare Pages.
# Set to "server" to keep the Node server and next/image optimisation (Vercel Pro).
# SITE_MODE=server

# Chromium for `pnpm shoot` and `pnpm audit-site`. Only needed if Playwright's
# browser is not at the default path.
# CHROME_PATH=/usr/bin/chromium

# The contact form posts to the endpoint in site.config.ts, not to an env var,
# so a client's form keeps working wherever the site is rebuilt.

# Deploying to a client's own shared hosting with `pnpm deploy-ftp`.
# Put the real values in .env.local (git-ignored), never here.
# FTP_HOST=ftp.example.pl
# FTP_USER=
# FTP_PASSWORD=
# FTP_REMOTE_DIR=/public_html
# FTP_PORT=21
# FTP_SECURE=true        # explicit FTPS; only set false if the host has no TLS

# The same hosting through the cPanel API with `pnpm deploy-cpanel`, for when
# FTP is closed from here or a cPanel login is all the client can give.
# CPANEL_URL=https://example.pl:2083   # or the server hostname on 443 + CPANEL_HOST
# CPANEL_HOST=cpanel.example.pl        # optional Host header (cPanel's proxy subdomain)
# CPANEL_USER=
# CPANEL_TOKEN=                        # cPanel → Security → Manage API Tokens; or
# CPANEL_PASSWORD=                     # the account password (session login)
# CPANEL_REMOTE_DIR=                   # optional; found from the domain otherwise

# Higgsfield imagery (pnpm imagery). Format: <key id>:<key secret>
# HIGGSFIELD_KEY=

# Chat assistant (pnpm deploy-ftp writes these into .chat-secret.php one
# directory above the web root; nothing under clients/ or src/ holds them).
# Use one API key per client so spend shows up per client in the console.
# CHATBOT_API_KEY=
# CHATBOT_MODEL=claude-haiku-4-5
# CHATBOT_DAILY_LIMIT=400      # model calls per day before the widget hands off to the phone

# Vercel preview host (pnpm deploy-vercel). A personal token from
# vercel.com/account/tokens; delete it there when the work is done.
# VERCEL_TOKEN=

# Phone assistant (planned; MARKET.md → The phone assistant). Not read by
# anything yet — the build-voice-agent script will need these.
# ELEVENLABS_API_KEY=
# TELNYX_API_KEY=
