# Nothing here is required for a static demo build.

# Deploy mode. Unset (default) = static export to out/ for Cloudflare Pages.
# Set to "server" to keep the Node server and next/image optimisation (Vercel Pro).
# SITE_MODE=server

# Chromium for `pnpm shoot` and `pnpm audit-site`. Only needed if Playwright's
# browser is not at the default path.
# CHROME_PATH=/usr/bin/chromium

# The contact form posts to the endpoint in site.config.ts, not to an env var,
# so a client's form keeps working wherever the site is rebuilt.

# Deploying to a client's own shared hosting with `pnpm deploy-ftp`.
# Put the real values in .env.local (git-ignored), never here.
# FTP_HOST=ftp.example.pl
# FTP_USER=
# FTP_PASSWORD=
# FTP_REMOTE_DIR=/public_html
# FTP_PORT=21
# FTP_SECURE=true        # explicit FTPS; only set false if the host has no TLS

# Higgsfield imagery (pnpm imagery). Format: <key id>:<key secret>
# HIGGSFIELD_KEY=
